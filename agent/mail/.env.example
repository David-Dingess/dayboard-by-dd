# OPTIONAL. The board's setup guide (Email section) writes these to
# data/settings.json; this file is only a fallback for the same values. Copy it
# to .env if you prefer. .env is gitignored — an app password is a password.

GMAIL_USER=you@example.com
# An APP PASSWORD, never the account password.
GMAIL_APP_PASSWORD=
GMAIL_MAILBOX=INBOX
MAIL_LIMIT=15

# Any IMAP server. Defaults are Gmail's.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_TRASH=[Gmail]/Trash
