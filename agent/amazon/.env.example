# OPTIONAL. The board's setup guide (Packages section) writes these to
# data/settings.json; this file is only a fallback for the same values. Copy it
# to .env if you prefer. .env is gitignored — this is your Amazon login.

AMAZON_USERNAME=you@example.com
AMAZON_PASSWORD=

AMAZON_MAX_ORDERS=12
AMAZON_WITHIN_DAYS=45
AMAZON_DELIVERED_DAYS=3
AMAZON_RETURN_WARN_DAYS=7
AMAZON_MAX_TRACKER_FETCHES=10

# Dump raw order-card and tracker HTML for tuning. Contains your address;
# agent/amazon/debug/ is gitignored.
# AMAZON_DEBUG_DIR=debug
