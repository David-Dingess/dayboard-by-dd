# Dayboard by DD — optional environment overrides.
#
# YOU DO NOT NEED THIS FILE. Everything is configured in the board's setup
# guide and stored in data/settings.json (gitignored). The variables below are
# read only as FALLBACKS when the matching setting is empty, for anyone who
# prefers an env file or is migrating from an older board. A value saved in the
# settings menu always wins.
#
# Copy to .env.local if you want any of them. Never commit .env.local.

# The board's port, if not 6767 (also settable in Settings -> Screen & look).
# PORT=6767

# Calendars: Label|url or Label|colour|url, ; separated. Colours without the #.
# SUBSCRIBED_CALENDARS="Personal|https://example.com/personal.ics;Work|e0913a|https://..."

# Discord
# DISCORD_GUILD_IDS=123,456
# DISCORD_SELF_NAME=
# DISCORD_SELF_ID=
# DISCORD_BOT_TOKEN=
# DISCORD_WATCH_IDS=

# Twitch (npm run twitch:auth fills the last two)
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_REFRESH_TOKEN=
# TWITCH_USER_ID=

# The .ics feed tokens, comma separated, newest first.
# FEED_TOKENS=

# Where the PC agent listens. Keep the literal 127.0.0.1.
# NEXT_PUBLIC_NOWPLAYING_URL=http://127.0.0.1:7343

# Declare a read-only copy of the board: every write is refused.
# DAYBOARD_TODOS=0

# The framed windows' DevTools ports and Chrome profiles, if the defaults clash.
# DAYBOARD_STREAM_PORT=9224
# DAYBOARD_MUSIC_PORT=9225
# DAYBOARD_STREAM_PROFILE=
# DAYBOARD_MUSIC_PROFILE=
