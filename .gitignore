# dependencies
/node_modules
deck/node_modules/

# next.js
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts
.next-check/

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ENVIRONMENT FILES — never committed. The settings menu writes
# data/settings.json instead; .env.local is only an optional override.
.env
.env.*
!.env.example
agent/*/.env

# THE SETTINGS FILE. It holds credentials typed into the setup guide — a bot
# token, an app password, calendar URLs — and belongs on one machine only.
data/settings.json

# A maintainer's own details for the validate leak scan. Committing it would
# publish exactly what it exists to keep out.
.private-terms

# What the board and its pollers write for themselves. Personal by nature
# (your to-dos, your inbox, your workouts) and regenerated as you use it.
data/todos.json
data/notes.json
data/water.json
data/watched.json
data/health.json
data/mail.json
data/mail-queue.json
data/packages.json
data/*.tmp

# The team schedules and their manifest: refreshed daily from settings.
data/cache/

# Your own events. The one sample file stays so the layer exists.
data/layers/*.json
!data/layers/personal.json

# Agent build output. dist/ holds single-file exes built locally.
agent/**/bin/
agent/**/obj/
agent/**/dist/
agent/**/__pycache__/
agent/**/.venv/
agent/amazon/.amazonorders/
agent/amazon/debug/

# The Stream Deck plugin's build output and the generated profile, which
# carries a device serial.
deck/com.dayboard.deck.sdPlugin/bin/
deck/com.dayboard.deck.sdPlugin/logs/
deck/.profile-build/
deck/Dayboard.streamDeckProfile
